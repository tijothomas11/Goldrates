{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "International Reference: Preview",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/update_international_reference.py",
        "--recent-input",
        "international_gold_recent_preview.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "International Reference: Apply",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/update_international_reference.py",
        "--recent-input",
        "international_gold_recent_preview.json",
        "--apply"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}